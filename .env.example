# --- Required -------------------------------------------------------------
DISCORD_TOKEN=your-bot-token-here
# Application (client) ID from the app's "General Information" page
DISCORD_CLIENT_ID=your-application-id-here

# --- Optional ------------------------------------------------------------
# A test server ID. If set, slash commands register there INSTANTLY.
# Leave blank to register commands globally (can take up to ~1 hour to show up).
DISCORD_GUILD_ID=

# Set to "false" to keep the per-game guesses channel after a game ends.
DELETE_CHANNEL_AFTER_GAME=true
