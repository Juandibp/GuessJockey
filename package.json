{
  "name": "guess-jockey-bot",
  "version": "1.0.0",
  "description": "Guess Jockey — a Discord music guessing game: plays 30s song previews (Deezer) in voice and scores players on guessing the artist and title.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "deploy": "node src/deploy-commands.js",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "fastest-levenshtein": "^1.0.16",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5"
  }
}
